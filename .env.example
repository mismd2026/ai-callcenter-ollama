# Public address the customer's recorder app connects to (written into its bundle)
PUBLIC_URL=https://callcenter.example.com
# PUBLIC_CA_FILE=/etc/callcenter/ca.pem   # only for a private CA
STATE_DIR=state
# sha256 of the admin token: python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" <token>
ADMIN_TOKEN_SHA256=
POSTGRES_PASSWORD=change-me
