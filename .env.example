OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER=3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
EMBEDDING_MODEL=intfloat/multilingual-e5-base
FAQ_DIR=data/faq
FAQ_DIRECT_THRESHOLD=0.86
RAG_CONTEXT_THRESHOLD=0.70
MAX_AI_TURNS=3
MAX_HISTORY_TURNS=3
CALL_IDLE_TIMEOUT_S=600
HANDOFF_TTL_S=1800
RECORD_TTL_S=86400
